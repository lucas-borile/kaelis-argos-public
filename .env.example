DEFAULT_CAPTURE_INTERVAL_S=15
ARGOS_ENV=development
DATABASE_URL=postgresql://argos:argos@127.0.0.1:5432/argos
PROCESS_CAMERA_DELAY_S=0.0
PROCESS_CYCLE_PAUSE_S=0.2
PROCESS_CONCURRENCY=2
CAPTURE_WORKER_ENABLED=true
CAPTURE_WORKER_INTERVAL_S=3
CAPTURE_WORKER_ERROR_INTERVAL_S=10
CAPTURE_WORKER_MAX_STALE_S=20
CAPTURE_FFMPEG_PIPE_ENABLED=true
CAPTURE_FFMPEG_READ_TIMEOUT_S=12
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cpu
YOLO_IMGSZ=768
YOLO_IOU=0.65
YOLO_MAX_DET=300
PERSON_CONFIDENCE_MIN=0.25
YOLO_WARMUP=true
YOLO_BATCH_ENABLED=true
YOLO_BATCH_SIZE=4
PRIORITY_SCHEDULER_ENABLED=true
PRIORITY_MAX_CAMERAS_PER_CYCLE=8
PRIORITY_FOCUS_TTL_S=20
PRIORITY_ACTIVITY_DECAY_S=180
PRIORITY_EVENT_GRACE_S=8
FRAME_CHANGE_GATE_ENABLED=true
FRAME_CHANGE_THRESHOLD=0.018
FRAME_CHANGE_PIXEL_THRESHOLD=0.012
FRAME_CHANGE_PIXEL_DELTA=18
FRAME_CHANGE_FORCE_INTERVAL_S=45
FRAME_CHANGE_DOWNSCALE_WIDTH=160
FRAME_CAPTURE_TIMEOUT_S=8
RTSP_CONNECT_TIMEOUT_S=8
RTSP_READ_TIMEOUT_S=8
ONVIF_TIMEOUT_S=6
ARGOS_CAMERA_SECRET_KEY=
ENABLE_MOCK_FALLBACK=false
STORE_FRAME_IMAGES=true
STORE_FRAME_IMAGES_IN_DB=false
FRAME_IMAGE_STORAGE_DIR=data/frames
SPMU_DB_PATH=spmu.db
OFFLINE_BACKOFF_BASE_S=15
OFFLINE_BACKOFF_MAX_S=120
CAMERA_AUTO_DEGRADE_ENABLED=true
CAMERA_DEGRADE_AFTER_FAILURES=8
CAMERA_DEGRADE_BACKOFF_S=600
RETENTION_ENABLED=true
RETENTION_MAX_FRAME_AGE_DAYS=7
RETENTION_INTERVAL_S=3600
# Em producao, defina ARGOS_ENV=production e substitua por senhas fortes.
# O backend recusa iniciar em producao sem ARGOS_USERS_JSON, com senhas de desenvolvimento ou com estes placeholders.
ARGOS_USERS_JSON={"admin":{"password":"troque-esta-senha-admin","role":"admin","name":"Administrador"},"operator":{"password":"troque-esta-senha-operador","role":"operator","name":"Operador"},"viewer":{"password":"troque-esta-senha-visualizador","role":"viewer","name":"Visualizador"}}
ARGOS_SESSION_TTL_SECONDS=28800
ARGOS_ALLOW_PRIVATE_CAMERA_NETWORKS=false
ARGOS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
FLOOR_PLAN_UPLOAD_MAX_BYTES=10485760
FLOOR_PLAN_MAX_PIXELS=25000000
FLOOR_PLAN_MAX_SIDE_PX=20000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=25
LOGIN_RATE_LIMIT_WINDOW_S=900
LOGIN_RATE_LIMIT_LOCKOUT_S=900
LOGIN_RATE_LIMIT_MAX_KEYS=10000
ARGOS_TRUST_PROXY_HEADERS=false
ARGOS_TELEGRAM_SECRET_KEY=
ARGOS_TELEGRAM_BOT_TOKEN=
ARGOS_BENCHMARK_LOGS=false
ARGOS_BENCHMARK_LOG_PATH=./logs/argos_processing.jsonl
ARGOS_BENCHMARK_REPORTS_PATH=./benchmarks/reports
ATTRIBUTE_CONFIDENCE_MIN=0.48
ATTRIBUTE_TRACK_CONFIDENCE_MIN=0.55
ATTRIBUTE_TRACK_HISTORY=8
ATTRIBUTE_DEBUG_IMAGES=false
ATTRIBUTE_DEBUG_DIR=data/debug_attributes
